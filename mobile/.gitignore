# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies

# pubspec.lock IS committed. This is an application, not a library, and Dart's
# guidance is that applications pin their transitive dependency versions so that
# every developer and every CI run builds the same bytes. Verified against
# Flutter 3.44.9 / Dart 3.12.2.

# Scratch output from local analyze/test runs.
analyze.txt
testrun.txt

# Generated code — regenerated by `flutter pub get` / build_runner, and a
# committed copy is a copy that goes stale against the .arb it came from.
lib/l10n/generated/
*.g.dart
*.freezed.dart

# Platform folders are generated by `flutter create` (see README → First run).
# Once signing config and Firebase files land in them they should be committed
# instead — with google-services.json and the keystore kept out.
/android/
/ios/

# IDE
.idea/
.vscode/
*.iml

# Local secrets. Nothing in this repo should need them, and if that changes the
# answer is --dart-define in CI, not a file here.
*.keystore
*.jks
key.properties
google-services.json
GoogleService-Info.plist
